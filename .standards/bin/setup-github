#!/usr/bin/env bash
# Configure the GitHub repository to match docs/standards (idempotent).
#
#   .standards/bin/setup-github [--dry-run] [--repo owner/name] [--approvals N]
#                               [--solo] [--no-admin-bypass]
#
# Applies:
#   - merges: squash only, PR title as commit message, delete branch after merge
#   - security: secret scanning + push protection, Dependabot alerts and
#     security updates, private vulnerability reporting
#   - ruleset "dev-standards" on the default branch: no deletion / force push,
#     linear history, pull request required (N approvals, squash only), and the
#     status checks listed in .github/required-checks.txt
#
# Requires: gh (authenticated with admin rights on the repository).
# Docs: docs/standards/GIT_WORKFLOW.md#分支保护
set -euo pipefail

dry_run=false
repo=""
approvals=1
admin_bypass=true
checks_file=".github/required-checks.txt"
ruleset_name="dev-standards"

usage() { sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'; }

while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) dry_run=true ;;
    --repo) repo=$2; shift ;;
    --approvals) approvals=$2; shift ;;
    --solo) approvals=0 ;;
    --no-admin-bypass) admin_bypass=false ;;
    -h|--help) usage; exit 0 ;;
    *) echo "unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

case "$approvals" in ''|*[!0-9]*) echo "--approvals must be a number" >&2; exit 2 ;; esac
command -v gh >/dev/null 2>&1 || { echo "gh (GitHub CLI) is required: https://cli.github.com" >&2; exit 1; }
if ! $dry_run; then
  gh auth status >/dev/null 2>&1 || { echo "run 'gh auth login' first" >&2; exit 1; }
fi
cd "$(git rev-parse --show-toplevel)"

if [ -z "$repo" ]; then
  repo=$(sed -n 's/^github_repo: *//p' .copier-answers.yml 2>/dev/null | tr -d "'\"" || true)
fi
if [ -z "$repo" ]; then
  repo=$(gh repo view --json nameWithOwner -q .nameWithOwner)
fi
[ -f "$checks_file" ] || { echo "missing $checks_file" >&2; exit 1; }

json_str() { local s=${1//\\/\\\\}; s=${s//\"/\\\"}; printf '"%s"' "$s"; }

checks_json=""
while IFS= read -r line || [ -n "$line" ]; do
  line=$(printf '%s' "$line" | sed 's/[[:space:]]*$//')
  case "$line" in ''|'#'*) continue ;; esac
  checks_json+="${checks_json:+,}{\"context\":$(json_str "$line")}"
done < "$checks_file"

bypass='[]'
if $admin_bypass; then
  # Repository admins may bypass (e.g. a solo maintainer's hotfix). Role id 5 = admin.
  bypass='[{"actor_id":5,"actor_type":"RepositoryRole","bypass_mode":"always"}]'
fi

ruleset=$(cat <<JSON
{
  "name": "$ruleset_name",
  "target": "branch",
  "enforcement": "active",
  "conditions": { "ref_name": { "include": ["~DEFAULT_BRANCH"], "exclude": [] } },
  "bypass_actors": $bypass,
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    { "type": "required_linear_history" },
    { "type": "pull_request", "parameters": {
        "required_approving_review_count": $approvals,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": ["squash"] } },
    { "type": "required_status_checks", "parameters": {
        "strict_required_status_checks_policy": false,
        "required_status_checks": [${checks_json}] } }
  ]
}
JSON
)

repo_settings='{
  "allow_squash_merge": true,
  "allow_merge_commit": false,
  "allow_rebase_merge": false,
  "delete_branch_on_merge": true,
  "squash_merge_commit_title": "PR_TITLE",
  "squash_merge_commit_message": "PR_BODY",
  "security_and_analysis": {
    "secret_scanning": { "status": "enabled" },
    "secret_scanning_push_protection": { "status": "enabled" }
  }
}'

if $dry_run; then
  echo "# repository: $repo (dry run, nothing changed)"
  echo; echo "PATCH /repos/$repo"; echo "$repo_settings"
  echo; echo "PUT /repos/$repo/vulnerability-alerts"
  echo "PUT /repos/$repo/automated-security-fixes"
  echo "PUT /repos/$repo/private-vulnerability-reporting"
  echo; echo "POST or PUT /repos/$repo/rulesets  ($ruleset_name)"; echo "$ruleset"
  exit 0
fi

step() { printf '• %s … ' "$1"; }
ok() { echo "ok"; }
warn() { echo "skipped ($1)"; }

step "merge settings and secret scanning"
if gh api -X PATCH "repos/$repo" --input - <<<"$repo_settings" >/dev/null 2>/tmp/setup-github.err; then ok
else warn "$(head -c 200 /tmp/setup-github.err)"; fi

for feature in vulnerability-alerts automated-security-fixes private-vulnerability-reporting; do
  step "$feature"
  if gh api -X PUT "repos/$repo/$feature" >/dev/null 2>/tmp/setup-github.err; then ok
  else warn "$(head -c 200 /tmp/setup-github.err)"; fi
done

step "ruleset '$ruleset_name' on the default branch"
existing=$(gh api "repos/$repo/rulesets" --jq ".[] | select(.name == \"$ruleset_name\") | .id" 2>/dev/null || true)
if [ -n "$existing" ]; then
  gh api -X PUT "repos/$repo/rulesets/$existing" --input - <<<"$ruleset" >/dev/null
else
  gh api -X POST "repos/$repo/rulesets" --input - <<<"$ruleset" >/dev/null
fi
ok

echo
echo "Done. Required checks: $(grep -cvE '^\s*(#|$)' "$checks_file") from $checks_file"
echo "Review: https://github.com/$repo/settings/rules"
