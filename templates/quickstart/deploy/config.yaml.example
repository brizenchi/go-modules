project: quickstart
env: dev

# 这是本地开发基线；部署生产环境时请以 .env.production.example 为准。
# 启动时环境变量会覆盖对应字段。

server:
  name: quickstart        # 会作为每条日志里的 service 字段
  port: 8080

log:
  level: info             # debug | info | warn | error
  format: json            # json | text；本地开发可用更易读的 text

http:
  # 留空时从 auth.frontend_redirect 自动提取 origin；多个前端域名时显式填写逗号分隔列表。
  allowed_origins: ""
  read_header_timeout_seconds: 10
  read_timeout_seconds: 15
  write_timeout_seconds: 30
  idle_timeout_seconds: 60

tracing:
  endpoint: ""            # 例如 localhost:4318；留空关闭导出器
  protocol: http          # http | grpc
  insecure: true          # 本地无 TLS 的采集器使用 true
  sample_rate: 1.0        # 0..1
  authorization: ""       # 例如 OpenObserve 的 Basic <base64>
  headers: {}             # 例如 { Authorization: "Basic <base64>" }
  url_path: ""            # 例如 OpenObserve 的 /api/default/v1/traces

db:
  host: localhost
  port: 5432
  user: app
  password: app
  name: quickstart
  ssl_mode: disable        # 仅限本机开发；生产必须 require / verify-ca / verify-full
  time_zone: UTC
  log_level: warn
  slow_query_ms: 200
  # 兼容旧项目：也可以只提供一条连接字符串：
  # dsn: "host=localhost user=app password=app dbname=quickstart port=5432 sslmode=disable TimeZone=UTC" # 仅本地

# ---------- auth ----------
auth:
  enabled: true                     # false 时不创建 auth 模块，也不挂登录路由
  user_jwt_secret: "CHANGE-ME-32-RANDOM-CHARS"
  user_jwt_expire_hours: 168       # 7 days
  ws_ticket_ttl_seconds: 300       # 5 minutes
  admin_email: ""                  # 用 APP_AUTH_ADMIN_EMAIL 配置 /admin 密码登录邮箱
  admin_password: ""               # 用 APP_AUTH_ADMIN_PASSWORD 配置；12–72 字节，勿提交真实密码
  admin_emails: []                 # 列表中的邮箱登录后获得 admin 角色
  frontend_redirect: "http://localhost:3000/login"  # OAuth 后端回调完成后的前端落点
  oauth_cookie_secure:                  # 留空按 provider callback URL 推导；本地 HTTP=false，生产 HTTPS=true

  email:
    enabled: true                   # false 时关闭邮箱验证码路由
    debug: false                   # 线上必须为 false；true 会在响应中返回验证码
    code:
      ttl_minutes: 10
      min_resend_gap_seconds: 60
      daily_cap: 10
      max_attempts: 5
  google:
    # enabled 可省略：配置 client_id/client_secret 后自动启用
    client_id: ""                  # 留空则不启用 Google 登录
    client_secret: ""
    redirect_url: "http://localhost:8080/api/v1/auth/google/callback"
    state_secret: "ANOTHER-CHANGE-ME-32-CHARS"
    state_ttl_minutes: 20          # 为授权确认和切换账号预留时间
    scope: "openid email profile"
  github:
    # enabled 可省略：配置 client_id/client_secret 后自动启用
    client_id: ""
    client_secret: ""
    redirect_url: "http://localhost:8080/api/v1/auth/github/callback"
    state_secret: "ANOTHER-GITHUB-STATE-SECRET"
    state_ttl_minutes: 20
    scope: "read:user user:email"

# ---------- email ----------
email:
  provider: log                    # none | log | brevo | resend
  brevo:
    api_key: ""                    # provider=brevo 时必填
    sender_email: ""
    sender_name: "quickstart"
  resend:
    api_key: ""                    # provider=resend 时必填
    sender_email: ""
    sender_name: "quickstart"

# ---------- billing ----------
billing:
  enabled:                         # 留空时检测 Stripe 凭据；也可显式设为 true/false
  provider: stripe                 # 换供应商时改 internal/platform/buildBilling
  stripe:
    secret_key: ""
    publishable_key: ""
    webhook_secret: ""
    trial_days: 0
    prices:
      starter_monthly: ""
      starter_yearly: ""
      pro_monthly: ""
      pro_yearly: ""
      premium_monthly: ""
      premium_yearly: ""
      lifetime: ""
      credits: []                  # 一次性积分包的 price ID 列表
    credits:
      per_package: 100             # 每购买一份积分包增加的积分

# ---------- referral ----------
referral:
  enabled: true
  prefix: "INV"                    # invitation code prefix
  base_link: "http://localhost:3000/invite?ref="
  activation_reward: 50            # credits granted to referrer on referee subscription
  activation_window_days: 0        # 0 表示不限制激活时间

# ---------- host ----------
# 当前 SaaS 自己的业务配置。在 internal/hostcfg 声明对应字段，
# 再通过 hostapi.Deps.Config 读取。
# 环境变量示例：host.openai_api_key → APP_HOST_OPENAI_API_KEY
host:
  signup_credits: 0
  uploads:
    enabled: false
    provider: local              # local | s3；S3/R2 使用 s3
    directory: "./var/uploads"  # 私有目录，不作为静态资源公开
    bucket: ""
    region: ""
    endpoint: ""
    use_path_style: false
    access_key_id: ""           # 生产使用部署密钥或默认 IAM 凭据链
    secret_access_key: ""
  welcome_email:
    enabled: false
    only_provider: ""              # google | github | email；空表示全部
    subject: "欢迎加入"
    text_body: "你的账号已经创建成功。"
    html_body: ""
