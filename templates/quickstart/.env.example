# foundation/config 读取进程环境变量；quickstart 启动时也会自动加载本地 .env。
#
# 本文件面向本地开发：日志更易读、允许返回验证码、邮件默认只写日志。
# 不要直接把这里的值当作生产默认值。

# 可选：让 quickstart 读取另一份配置文件。
CONFIG=deploy/config.yaml

# 服务与日志
APP_PROJECT=quickstart
APP_ENV=dev
APP_SERVER_NAME=quickstart
APP_SERVER_PORT=8080
APP_LOG_LEVEL=info
APP_LOG_FORMAT=text

# 浏览器来源和 HTTP 超时。生产环境只填写你的前端 HTTPS 域名，多个域名用逗号分隔。
APP_HTTP_ALLOWED_ORIGINS=http://localhost:3000
APP_HTTP_READ_HEADER_TIMEOUT_SECONDS=10
APP_HTTP_READ_TIMEOUT_SECONDS=15
APP_HTTP_WRITE_TIMEOUT_SECONDS=30
APP_HTTP_IDLE_TIMEOUT_SECONDS=60

# 链路追踪（OTLP）。endpoint 留空时不导出 span，但仍保留追踪中间件。
APP_TRACING_ENDPOINT=
APP_TRACING_PROTOCOL=http
APP_TRACING_INSECURE=true
APP_TRACING_SAMPLE_RATE=1
APP_TRACING_AUTHORIZATION=
# APP_TRACING_URL_PATH=/api/default/v1/traces

# 数据库
APP_DB_HOST=localhost
APP_DB_PORT=5432
APP_DB_USER=app
APP_DB_PASSWORD=app
APP_DB_NAME=quickstart
APP_DB_SSL_MODE=disable
APP_DB_TIME_ZONE=UTC
APP_DB_LOG_LEVEL=warn
APP_DB_SLOW_QUERY_MS=200
# 兼容旧项目：也可以使用一条 DSN：
# APP_DB_DSN=host=localhost user=app password=app dbname=quickstart port=5432 sslmode=disable TimeZone=UTC

# 认证
APP_AUTH_ENABLED=true
APP_AUTH_USER_JWT_SECRET=CHANGE-ME-32-RANDOM-CHARS
APP_AUTH_USER_JWT_EXPIRE_HOURS=168
APP_AUTH_WS_TICKET_TTL_SECONDS=300
APP_AUTH_FRONTEND_REDIRECT=http://localhost:3000/login

# 邮箱验证码登录。本地设为 true 时，发送验证码接口会在响应里返回验证码；
# 非本地环境必须关闭。
APP_AUTH_EMAIL_ENABLED=true
APP_AUTH_EMAIL_DEBUG=true
APP_AUTH_EMAIL_CODE_TTL_MINUTES=10
APP_AUTH_EMAIL_CODE_MIN_RESEND_GAP_SECONDS=60
APP_AUTH_EMAIL_CODE_DAILY_CAP=10
APP_AUTH_EMAIL_CODE_MAX_ATTEMPTS=5

# 邮件供应商。log 只把渲染后的邮件写入日志，不调用真实服务。
APP_EMAIL_PROVIDER=log
APP_EMAIL_BREVO_API_KEY=
APP_EMAIL_BREVO_SENDER_EMAIL=
APP_EMAIL_BREVO_SENDER_NAME=quickstart
APP_EMAIL_RESEND_API_KEY=
APP_EMAIL_RESEND_SENDER_EMAIL=
APP_EMAIL_RESEND_SENDER_NAME=quickstart

# Google OAuth
# APP_AUTH_GOOGLE_ENABLED=true
APP_AUTH_GOOGLE_CLIENT_ID=
APP_AUTH_GOOGLE_CLIENT_SECRET=
# client_id 和 client_secret 留空时不启用 Google OAuth；
# redirect_url 和 state_secret 保留模板值也不会自动启用。
APP_AUTH_GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback
APP_AUTH_GOOGLE_STATE_SECRET=ANOTHER-CHANGE-ME-32-CHARS
APP_AUTH_GOOGLE_STATE_TTL_MINUTES=20
APP_AUTH_GOOGLE_SCOPE=openid email profile

# GitHub OAuth
# APP_AUTH_GITHUB_ENABLED=true
APP_AUTH_GITHUB_CLIENT_ID=
APP_AUTH_GITHUB_CLIENT_SECRET=
APP_AUTH_GITHUB_REDIRECT_URL=http://localhost:8080/api/v1/auth/github/callback
APP_AUTH_GITHUB_STATE_SECRET=ANOTHER-GITHUB-STATE-SECRET
APP_AUTH_GITHUB_STATE_TTL_MINUTES=20
APP_AUTH_GITHUB_SCOPE=read:user user:email

# 支付 / Stripe
APP_BILLING_ENABLED=false
APP_BILLING_PROVIDER=stripe
APP_BILLING_STRIPE_SECRET_KEY=
APP_BILLING_STRIPE_PUBLISHABLE_KEY=
APP_BILLING_STRIPE_WEBHOOK_SECRET=
APP_BILLING_STRIPE_TRIAL_DAYS=0
APP_BILLING_STRIPE_PRICES_STARTER_MONTHLY=
APP_BILLING_STRIPE_PRICES_STARTER_YEARLY=
APP_BILLING_STRIPE_PRICES_PRO_MONTHLY=
APP_BILLING_STRIPE_PRICES_PRO_YEARLY=
APP_BILLING_STRIPE_PRICES_PREMIUM_MONTHLY=
APP_BILLING_STRIPE_PRICES_PREMIUM_YEARLY=
APP_BILLING_STRIPE_PRICES_LIFETIME=
APP_BILLING_STRIPE_PRICES_CREDITS=
APP_BILLING_STRIPE_CREDITS_PER_PACKAGE=100

# 当前 SaaS 的业务回调配置
APP_HOST_SIGNUP_CREDITS=0
APP_HOST_WELCOME_EMAIL_ENABLED=false
APP_HOST_WELCOME_EMAIL_ONLY_PROVIDER=
APP_HOST_WELCOME_EMAIL_SUBJECT=欢迎加入
APP_HOST_WELCOME_EMAIL_TEXT_BODY=你的账号已经创建成功。

# 邀请
APP_REFERRAL_ENABLED=true
APP_REFERRAL_PREFIX=INV
APP_REFERRAL_BASE_LINK=http://localhost:3000/invite?ref=
APP_REFERRAL_ACTIVATION_REWARD=50
APP_REFERRAL_ACTIVATION_WINDOW_DAYS=0
