# 复制为 .env.local 后用于本地开发：
#   cp .env.example .env.local

# 用户在浏览器中访问的前端地址。
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Go quickstart 后端地址及 API 前缀。
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# 登录方式以后端 /capabilities 为准。通常无需设置前端登录开关；如需进一步隐藏
# 后端已启用的方式，再设置 NEXT_PUBLIC_AUTH_EMAIL_ENABLED 或
# NEXT_PUBLIC_AUTH_OAUTH_PROVIDERS（支持 google、github，逗号分隔）。

# 界面名称和默认值
NEXT_PUBLIC_APP_NAME=Clawmesh Quickstart Frontend
# 总览显示演示说明与测试卡；仅控制展示，Stripe 模式由后端密钥决定。
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_DEFAULT_PLAN=pro
NEXT_PUBLIC_DEFAULT_INTERVAL=monthly
NEXT_PUBLIC_DEFAULT_CREDITS_QUANTITY=1

# Stripe Checkout 完成或取消后返回的前端路径。
NEXT_PUBLIC_STRIPE_SUCCESS_PATH=/billing?checkout=success
NEXT_PUBLIC_STRIPE_CANCEL_PATH=/billing?checkout=cancelled
